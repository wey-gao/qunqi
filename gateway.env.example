PORT=8099
PUBLIC_BASE=http://127.0.0.1:8099
AGENT_MODE=onebot
ASTRBOT_WS=
BOT_ID=2001
BOT_NAME=AI 助手
BOT_TOKEN=change-me-to-a-long-random-token
ADMIN_CODES=CHANGE01
MAX_UPLOAD_MB=300

# 安全强度：private=自用（默认，少打扰）；public=对外开放（强制校验）
SECURITY_LEVEL=private
# 仅 public 模式默认开启，也可单独覆盖：
